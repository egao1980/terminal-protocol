(in-package #:terminal-protocol)

;;; A mode designator is a keyword from +MODE-NAMES+, (:DEC n) for DEC private
;;; mode n (CSI ? n h), or (:ANSI n) for ANSI mode n (CSI n h).

(defparameter +mode-names+
  '((:disable-keyboard :ansi 2)
    (:insert :ansi 4)
    (:send-receive :ansi 12)
    (:linefeed :ansi 20)
    (:cursor-keys :dec 1)
    (:132-column :dec 3)
    (:slow-scroll :dec 4)
    (:reverse-colors :dec 5)
    (:origin :dec 6)
    (:wraparound :dec 7)
    (:autorepeat :dec 8)
    (:mouse-event-x10 :dec 9)
    (:cursor-blinking :dec 12)
    (:cursor-visible :dec 25)
    (:enable-mode-3 :dec 40)
    (:reverse-wrap :dec 45)
    (:alt-screen-legacy :dec 47)
    (:keypad-keys :dec 66)
    (:backarrow-key :dec 67)
    (:left-right-margin :dec 69)
    (:mouse-event-normal :dec 1000)
    (:mouse-event-button :dec 1002)
    (:mouse-event-any :dec 1003)
    (:focus-event :dec 1004)
    (:mouse-format-utf8 :dec 1005)
    (:mouse-format-sgr :dec 1006)
    (:mouse-alternate-scroll :dec 1007)
    (:mouse-format-urxvt :dec 1015)
    (:mouse-format-sgr-pixels :dec 1016)
    (:ignore-keypad-with-numlock :dec 1035)
    (:alt-esc-prefix :dec 1036)
    (:alt-sends-escape :dec 1039)
    (:reverse-wrap-extended :dec 1045)
    (:alt-screen :dec 1047)
    (:save-cursor :dec 1048)
    (:alt-screen-save-cursor-clear :dec 1049)
    (:bracketed-paste :dec 2004)
    (:synchronized-output :dec 2026)
    (:grapheme-cluster :dec 2027)
    (:report-color-scheme :dec 2031)
    (:report-visibility :dec 2033)
    (:in-band-size-reports :dec 2048)
    (:kitty-paste-events :dec 5522))
  "Named modes → (kind number). Names follow libghostty-vt's GHOSTTY_MODE_*.")

(defun normalize-mode (designator)
  "→ (values kind number), where KIND is :DEC or :ANSI. Signals
TERMINAL-INVALID-ARGUMENT, with a USE-VALUE restart taking another designator."
  (loop
    (cond ((keywordp designator)
           (let ((entry (assoc designator +mode-names+)))
             (when entry
               (return (values (second entry) (third entry))))))
          ((and (consp designator)
                (member (first designator) '(:dec :ansi))
                (consp (rest designator))
                (null (cddr designator))
                (typep (second designator) '(integer 0 65535)))
           (return (values (first designator) (second designator)))))
    (setf designator (invalid-argument 'mode designator))))
